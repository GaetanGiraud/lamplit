{
  "name": "magicstories",
  "version": "0.1.0",
  "private": true,
  "description": "A chat-centred, text-only storytelling app talking straight to any OpenAI-compatible endpoint.",
  "workspaces": [
    "app",
    "server",
    "e2e",
    "electron"
  ],
  "scripts": {
    "start": "node tools/dev.mjs",
    "server": "node server/src/index.js",
    "build": "npm run build -w app",
    "package": "node tools/package.mjs",
    "desktop": "node tools/desktop.mjs",
    "desktop:stage": "node tools/desktop.mjs --stage-only",
    "desktop:dist": "node tools/desktop.mjs --dist",
    "screenshots": "node tools/screenshots.mjs",
    "providers": "node --experimental-strip-types tools/probe-providers.mjs",
    "icons": "node tools/icons.mjs",
    "test": "npm run test -w app && npm run test -w server",
    "test:app": "npm run test -w app",
    "test:server": "npm run test -w server",
    "e2e": "npm run build -w app && npm run test -w e2e",
    "e2e:quick": "npm run test -w e2e",
    "smoke": "node tools/smoke.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "license": "MIT"
}
